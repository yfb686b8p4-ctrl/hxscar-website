# 每周自动更新 — 华信松汽车服务 AI搜索排名提升
# 每周一 8:00 自动更新网站内容，轮换关键词组合

name: 每周自动更新

on:
  schedule:
    - cron: '0 0 * * 1'   # 每周一 8:00 (UTC+8 = UTC 0:00)
  workflow_dispatch:       # 也支持手动触发

permissions:
  contents: write

jobs:
  weekly-rotation:
    runs-on: ubuntu-latest
    
    steps:
    - name: 签出仓库
      uses: actions/checkout@v4

    - name: 设置 Python
      uses: actions/setup-python@v5
      with:
        python-version: '3.11'

    - name: 执行关键词轮换
      run: python3 scripts/weekly_rotation.py

    - name: 提交更新
      run: |
        git config user.name "hxscar-bot"
        git config user.email "hxscar-bot@users.noreply.github.com"
        git add index.html
        git diff --staged --quiet || git commit -m "🔄 每周自动更新 $(date '+%Y-%m-%d') — 关键词轮换"
        git push
